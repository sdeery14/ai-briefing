{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sdeery14/ai-briefing/schemas/daily_briefing.v1.schema.json",
  "title": "daily_briefing.v1",
  "description": "The briefing AI Briefing exports for one day (RFC v0.3 section 8.2, ADR-006). Every string is plain text derived from untrusted web content: a consumer must escape it and must never pass it to a model prompt. Every URL comes from a stored source document, never from model output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "briefing_id",
    "local_date",
    "timezone",
    "generated_at",
    "status",
    "degraded_reasons",
    "stories",
    "watchlist"
  ],
  "properties": {
    "schema_version": {
      "const": "daily_briefing.v1"
    },
    "briefing_id": {
      "$ref": "#/$defs/identifier"
    },
    "local_date": {
      "description": "The calendar date the briefing is for, in the stated time zone.",
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "timezone": {
      "description": "An IANA time zone name, for example America/New_York.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$"
    },
    "generated_at": {
      "description": "When this version was generated, in UTC.",
      "type": "string",
      "format": "date-time",
      "maxLength": 27,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "status": {
      "description": "ready: a normal briefing. degraded: produced, but something was skipped; degraded_reasons says what. empty: nothing to report; a consumer omits the section.",
      "enum": ["ready", "degraded", "empty"]
    },
    "degraded_reasons": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "stories": {
      "description": "The day's developments, most significant first. At most five.",
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/story"
      }
    },
    "watchlist": {
      "description": "Short items worth watching that did not qualify as stories.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/watch_item"
      }
    },
    "concept_note": {
      "$ref": "#/$defs/concept_note"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "ready"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"degraded_reasons": {"maxItems": 0}}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "degraded"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"degraded_reasons": {"minItems": 1}}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "empty"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "stories": {"maxItems": 0},
          "watchlist": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "required": ["concept_note"]
      },
      "then": {
        "properties": {"stories": {"minItems": 1}}
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "web_url": {
      "description": "An http or https address taken from a stored source document.",
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https?://[^\\s<>\"]+$"
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "story_id",
        "decision_id",
        "class",
        "confidence",
        "headline",
        "summary",
        "why_it_matters",
        "independent_source_count",
        "evidence"
      ],
      "properties": {
        "item_id": {"$ref": "#/$defs/identifier"},
        "story_id": {"$ref": "#/$defs/identifier"},
        "decision_id": {"$ref": "#/$defs/identifier"},
        "class": {
          "description": "The final class set by the editorial policy. A watch item appears in the watchlist, and a low item does not appear.",
          "enum": ["major", "practical"]
        },
        "confidence": {
          "enum": ["low", "moderate", "high"]
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "independent_source_count": {
          "description": "Distinct primary or independent sources. Several articles repeating one announcement count once.",
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "description": "The source documents behind the story. A link shows where a statement came from; it does not show that the statement is true.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "source_name", "source_role"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "url": {"$ref": "#/$defs/web_url"},
        "source_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source_role": {
          "enum": ["primary", "vendor", "independent", "community", "aggregator"]
        }
      }
    },
    "watch_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "headline", "url"],
      "properties": {
        "item_id": {"$ref": "#/$defs/identifier"},
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {"$ref": "#/$defs/web_url"}
      }
    },
    "concept_note": {
      "description": "Optional background written by the model, tied to one of the day's stories. The name 'lesson' is reserved for a later version.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "related_item_id"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "related_item_id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
